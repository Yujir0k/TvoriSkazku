NODE_ENV=development
HOST=127.0.0.1
PORT=3001
FRONTEND_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://tvoriskazku_user:change-me-password@127.0.0.1:5433/tvoriskazku?schema=public
REDIS_URL=redis://127.0.0.1:6379
MAILPIT_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025
POSTGRES_DB=tvoriskazku
POSTGRES_USER=tvoriskazku_user
POSTGRES_PASSWORD=change-me-password
POSTGRES_PORT=5433
REDIS_PORT=6379
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=tvoriskazku_session
SESSION_REDIS_PREFIX=tvoriskazku:session:
SESSION_USER_INDEX_PREFIX=tvoriskazku:session-user:
SESSION_ROLLING_TTL=86400
# Yandex Cloud AI (Foundation Models / DeepSeek)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4-flash
YANDEX_MAX_TOKENS=9000
YANDEX_TIMEOUT_MS=60000

# Foreign TTS Relay (stateless — зарубежный сервер-ретранслятор для ElevenLabs)
FOREIGN_TTS_RELAY_URL=
FOREIGN_TTS_RELAY_SECRET=
FOREIGN_TTS_ENABLED=false
FOREIGN_TTS_TIMEOUT_MS=300000

# ElevenLabs TTS (используется только если FOREIGN_TTS_ENABLED=false)
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_TIMEOUT_MS=300000

# Image generation through Polza.ai Media API
# Create the key in your Polza.ai dashboard and keep it on backend only.
POLZA_AI_API_KEY=
POLZA_AI_BASE_URL=https://polza.ai/api
POLZA_IMAGE_MODEL=black-forest-labs/flux.2-flex
POLZA_IMAGE_TIMEOUT_MS=180000

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=tvoriskazku
MINIO_SECRET_KEY=change-me-password
MINIO_BUCKET=tvoriskazku
MINIO_PRESIGNED_EXPIRY_SECONDS=3600
VITE_API_BASE_URL=http://127.0.0.1:3001/api
