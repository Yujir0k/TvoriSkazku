# ─── Foreign TTS Relay (stateless) ─────────────────────────────────────────
# Этот сервер является техническим ретранслятором между российским backend
# и ElevenLabs. Он не хранит тексты, аудио или пользовательские данные.
# Подробнее: см. README.md

# Порт, на котором работает relay
PORT=4000

# API-ключ ElevenLabs
ELEVENLABS_API_KEY=

# Shared secret для server-to-server авторизации
# Должен совпадать с FOREIGN_TTS_RELAY_SECRET на основном backend
RELAY_SHARED_SECRET=
